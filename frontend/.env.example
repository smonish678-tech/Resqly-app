# Copy to .env for local development only. Do not commit .env.
REACT_APP_BACKEND_URL=http://localhost:8000
ENABLE_HEALTH_CHECK=false

# Demo OTP is intentionally off unless explicitly enabled for an isolated local build.
# Never set these in production.
REACT_APP_ENABLE_DEMO_OTP=false
REACT_APP_ENABLE_DEMO_PASSWORD_RESET=false
